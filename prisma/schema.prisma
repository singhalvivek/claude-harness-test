// Wanderline data model — SQLite via Prisma (SQLite is the production DB here).
// Photo BYTES never live in the DB; the DB stores opaque storage keys resolved
// to URLs at read time via storage.url(key). See spec/data.md + spec/architecture.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id           String   @id @default(cuid())
  title        String
  description  String?
  // story theme: "cinematic" | "editorial" | "minimal" | "vintage" (default cinematic)
  theme        String   @default("cinematic")
  coverPhotoId String?
  // shareSlug / isPublished exist in Phase 1 (nullable / default) but are
  // only populated by the Phase 2 publish flow.
  shareSlug    String?  @unique
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stops Stop[]
}

model Stop {
  id                String    @id @default(cuid())
  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order             Int
  title             String?
  placeName         String?
  lat               Float?
  lng               Float?
  // "exact" | "approximate" | "none"
  locationPrecision String    @default("none")
  occurredAt        DateTime?
  body              String?
  // Per-stop decorative motif rendered as an animated ornament on the serpentine
  // + a card accent. One of: none (default) | flower | mountain | tree | train |
  // plane | boat | car | tent | camera | star | compass | sun | heart.
  motif             String    @default("none")
  // Phase 2.5 — one short line of how this stop FELT, rendered as a themed quote
  // in the story. Max 200 chars (zod at the API boundary); blank -> null.
  feeling           String?
  // "card" (own beat on the serpentine) | "inline" (pull-quote in the stop card)
  // | "none" (kept but hidden).
  feelingPlacement  String    @default("card")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  photos Photo[]
  tags   StopTag[]

  @@unique([tripId, order])
}

// Domain concept: MEDIA — a photo OR a video. The table name intentionally stays
// `Photo` (no rename migration, no data loss); Phase 2.5 discriminates the row by
// `kind` so a video reuses the identical ordering / cover / caption / reorder /
// delete logic. There is deliberately NO parallel `Video` model.
model Photo {
  id          String   @id @default(cuid())
  stopId      String
  stop        Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  order       Int
  isCover     Boolean  @default(false)
  // "photo" | "video" — the media discriminator; every pre-2.5 row backfills to "photo".
  kind        String   @default("photo")
  webKey      String
  thumbKey    String
  originalKey String
  // video only: the client-captured poster JPEG at .../<uuid>/poster.jpg
  posterKey   String?
  // video only: seconds, read from <video>.duration in the BROWSER (no ffmpeg).
  durationSec Float?
  width       Int
  height      Int
  caption     String?
  createdAt   DateTime @default(now())

  @@unique([stopId, order])
}

// Phase 2 — mood/activity tags. Many-to-many with Stop via the StopTag join
// table (SQLite has no scalar-list columns, so tags use a relation table).
model Tag {
  id        String   @id @default(cuid())
  label     String   @unique
  // "mood" | "activity"
  kind      String
  createdAt DateTime @default(now())

  stops StopTag[]
}

model StopTag {
  stopId String
  tagId  String
  stop   Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([stopId, tagId])
}
