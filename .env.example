# ─────────────────────────────────────────────────────────────────────────────
# Wanderline — environment configuration
#
# Copy this file to `.env` (the postinstall step does this automatically on a
# fresh `pnpm install` if `.env` is missing). `.env` is gitignored; this
# `.env.example` is the committed, secret-free template.
#
# The app BOOTS WITHOUT SECRETS: if OWNER_PASSWORD / SESSION_SECRET are left
# unset (commented out), safe dev defaults apply and a visible warning is shown.
# Set real values below to secure a real deployment.
# ─────────────────────────────────────────────────────────────────────────────

# --- Owner authentication (optional for local dev; REQUIRED for a real deploy) ---
# The single owner password used at /login. If unset -> dev default "letmein"
# and the login page shows a yellow "using dev default password" banner.
# OWNER_PASSWORD=

# Secret used to HMAC-sign the owner session cookie. If unset -> a fixed,
# insecure dev secret is used (fine for local testing, NOT for production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# --- Database (SQLite via Prisma — this is the production database here) ---
# Relative SQLite paths resolve next to prisma/schema.prisma, i.e. -> prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Photo storage (Phase 1: local disk behind the PhotoStorage interface) ---
# Directory where processed photo derivatives + originals are written.
PHOTO_STORAGE_DIR="./storage/photos"
# Which storage backend to use. Phase 1 supports "local" only ("r2" lands in Phase 3).
PHOTO_STORAGE_BACKEND="local"

# --- Geocoding (OpenStreetMap Nominatim, proxied server-side) ---
# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT="Wanderline/0.1 (personal trip journal; contact: owner@example.com)"

# ─────────────────────────────────────────────────────────────────────────────
# FUTURE — Cloudflare R2 / S3 photo storage (Phase 3 only; UNUSED in Phase 1).
# Leave commented until PHOTO_STORAGE_BACKEND="r2" is supported.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# ─────────────────────────────────────────────────────────────────────────────
